# Touch new files in a new directory (touch + mkdir -p)
function touchy() {
  for path in $@; do
    mkdir -p "$(dirname "$path")"
    touch "$path"
  done
}

# Copy and Change Owner
function cpwn() {
  function usage() {
    cat <<EOF

  Usage: cpwn <source> <destination>

    Description: copy file and change owner

EOF
  }

  if [[ $# -eq 2 ]] && [[ -f "$1" ]]; then
    sudo cp "$1" "$2"
    sudo chown $USER:$USER "$2"
  else
    usage
  fi
}

# Copy to new directory
function cpdirp() {
  function usage() {
    cat <<EOF

  Usage: cpdirp <source> <destination>

    Description: mkdir -p the <destination> and cp -R the <source>

    Examples:

      $ find stuff
      # ==> stuff
      # ==> stuff/.dofile
      # ==> stuff/a.file
      # ==> stuff/b
      # ==> stuff/b/c.file


      ### Copy the contents of the <source> folder ###

      $ cpdirp stuff/ stuff/this # stuff/ <-- has trailing slash

      $ find stuff/this
      # ==> stuff/this
      # ==> stuff/this/.dofile
      # ==> stuff/this/a.file
      # ==> stuff/this/b
      # ==> stuff/this/b/c.file


      ### Copy the entire <source> folder ###

      $ cpdirp stuff stuff/that # stuff <-- NO trailing slash

      $ find stuff/that
      # ==> stuff/that
      # ==> stuff/that/.dofile
      # ==> stuff/that/a.file
      # ==> stuff/that/b
      # ==> stuff/that/b/c.file


      ### Copy a <source> file to folder ###

      $ cpdirp stuff/a.file stuff/what/

      $ find stuff/what
      # ==> stuff/what
      # ==> stuff/what/a.file

EOF
  }

  if [[ $# -eq 2 ]]; then
    mkdir -p "$2"
    cp -R "$1" "$2"
  else
    usage
  fi
}

# Create a new directory
alias mdp="mkdir -p"

# Create a new directory and enter it
function md() {
  mkdir -p "$@" && cd "$@"
}

# Remove files and/or directories
function rmd() {
  if [[ "$1" = "." ]]; then
    # remove everything inside the CWD,
    # including dotfiles while suppressing
    # the error message for . and ..
    find . -exec rm -rf {} 2> /dev/null \;
  else
    rm -rf "$@"
  fi
}

# Remove empty directories
alias rmd_empty="find . -empty -type d -delete"

# Erase the contents of a directory, leaving the folder
function remove_contents_from_directory_but_leave_directory() {
  function usage() {
    cat <<EOF

  Usage: remove_contents_from_directory_but_leave_directory <directory>

    Description:
      Remove the contents of a directory,
      leaving the directory itself in place.

EOF
  }

  if [ -z "$1" ]; then
    usage
    return 1
  fi

  if [ -d "$1" ]; then
    (
      cd "$1"
      find . -exec rm -rf {} 2> /dev/null \;
    )
  else
    cat <<EOF

    Error: Not a valid directory => "$1"

EOF
  fi

}
alias rid="remove_contents_from_directory_but_leave_directory"

# Change directory and list contents
function cdl() {
  cd "$@" && la
}

# Find files or directories (by name) with grep
function _q() {
  find . -type "$1" | grep "$2" | grep -v "$2.*/"
}

# Find files with grep
function qf() {
  _q f "$@"
}

# Find directories with grep
function qd() {
  _q d "$@"
}

# Determine size of a file or total size of a directory
function fs() {
  if du -b /dev/null > /dev/null 2>&1; then
    local arg=-sbh
  else
    local arg=-sh
  fi
  if [[ -n "$@" ]]; then
    du $arg -- "$@"
  else
    du $arg .[^.]* *
  fi
}
alias file_size="fs"
alias folder_size="fs"

# List all file extensions in CWD and total count for each type.
# Pass number for -maxdepth (default is infinity)
function count_files_by_extension_in_current_directory() {
  local depth=${1:-1}
  local maxdepth="-maxdepth $depth"
  if ! [[ $1 -ge 1 ]]; then
    maxdepth=""
  fi
  eval "find . -type f $maxdepth | rev | cut -d. -f1 | rev  | tr '[:upper:]' '[:lower:]' | sort | uniq -c | sort -rn"
}
alias xfiles="count_files_by_extension_in_current_directory"

# Find the biggest files in a directory
function list_big_files() {
  echo "Biggest Files (KB) in $PWD"
  local target="."
  if [[ -n "$@" ]]; then
    target="$@"
  fi
  find "$target" -type f | xargs -I {} du -sk "{}" | sort -nr
}
alias bigfiles="list_big_files"

# Open Editor
function e() {
  local ed="$EDITOR"
  if [[ -z "$1" ]]; then
    ed+=" ."
  else
    ed+=" $1"
  fi
  $ed
}

# List all environment variables that match regexp
alias grep_env="env | grep "
alias envs="grep_env"

# List aliases that match regexp, e.g. $ alls .*sudo.*
function find_aliases_matching_regex() {
  alias -p | grep "^alias $1" | sed "s#^alias ##" | grep $1
}
alias alls="find_aliases_matching_regex"

# List functions that match regexp, e.g. $ fnls .*c.*
function find_functions_matching_regex() {
  declare -F | grep "^declare -f $1" | sed "s#^declare -f ##" | awk '{print $0 "()"}' | grep $1
}
alias fnls="find_functions_matching_regex"

# List functions (with source) that match regexp, e.g. $ funls .*c.*
function find_functions_with_source_matching_regex() {
  fns="$(fnls $1)"
  for fn in "$fns"; do
    _fn=$(echo "$fn" | sed "s#()##")
    declare -f $_fn
  done
}
alias funls="find_functions_with_source_matching_regex"

# List functions AND aliases that match regexp, e.g. $ fnalls .*c.*
function find_aliases_and_functions_matching_regex() {
  find_aliases_matching_regex "$1"
  echo
  find_functions_matching_regex "$1"
}
alias fnalls="find_aliases_and_functions_matching_regex"

# List functions (with source) AND aliases that match regexp, e.g. $ funalls .*c.*
function find_aliases_and_functions_matching_regex() {
  find_aliases_matching_regex "$1"
  find_functions_matching_regex "$1"
}
alias funalls="find_aliases_and_functions_matching_regex"

# Generate a stubbed Bash file
function generate_stubbed_bash_file() {
  if [[ $# -eq 0 ]]; then
    printf "\n  Usage: generate_stubbed_bash_file <name>\n\n"
  else
    read -r -d '' src <<'EOF'
#!/usr/bin/env bash

function {{name}}() {

}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  export -f {{name}}
else
  {{name}}
fi
EOF
  echo "$src" | sed 's#{{name}}#'$1'#g' > "$1"
  chmod +x "$1"
  e "$1"
  fi
}
alias bash_file="generate_stubbed_bash_file"

