#!/usr/bin/env bash

shopt -s direxpand 2>/dev/null
shopt -s autocd 2>/dev/null
export LESS="r"
export PAGER="less"

# Prompt display customization
function prompter() {
  local _ps1=""
  if [[ $# -gt 0 ]]; then
    export PROMPT_TYPE="$1"
  fi

  local sshd
  local git
  local status
  local branch

  sshd="$(ssh-add -l 2>/dev/null | awk 'BEGIN {r=""} \
    !/no identities/ {r="* "}\
    END {print r}
  ')"
  status="$(git status 2>/dev/null)"
  branch="$(echo "$status" | awk '/On branch/ {print $3}')"

  if [[ "$branch" != "" ]]; then
    local flags
    flags="$(
      echo "$status" | awk 'BEGIN {r=""} \
        /^Changes to be committed:$/        {r=r "+"}\
        /^Changes not staged for commit:$/  {r=r "!"}\
        /^Untracked files:$/                {r=r "?"}\
        END {print r}'
    )"
    git=" [$branch$flags]"
  fi

  case "$PROMPT_TYPE" in
  long)
    _ps1="\u @$(hostname -s) in \$PWD"$git
    PS1="$(hr)$PROMPTER_PREFIX$sshd$(tput rev)$_ps1$(tput sgr0)\n$PROMPTER_PREFIX$ " ; export PS1
    ;;
  short)
    _ps1="$(pwd | sed "s#$HOME#~#")"$git
    PS1="$(hr)$PROMPTER_PREFIX$sshd$(tput rev)$_ps1$(tput sgr0)\n$PROMPTER_PREFIX$ " ; export PS1
    ;;
  node)
    prompter_prefix_set_with_current_node_version
    _ps1="$(pwd | sed "s#$HOME#~#")"$git
    PS1="$(hr)$PROMPTER_PREFIX$sshd$(tput rev)$_ps1$(tput sgr0)\n$PROMPTER_PREFIX$ " ; export PS1
    ;;
  python)
    prompter_prefix_set_with_current_python_version
    _ps1="$(pwd | sed "s#$HOME#~#")"$git
    PS1="$(hr)$PROMPTER_PREFIX$sshd$(tput rev)$_ps1$(tput sgr0)\n$PROMPTER_PREFIX$ " ; export PS1
    ;;
  z)
    _ps1="$(pwd | sed "s#$HOME#~#" | sed "s#\(/.\)\([^\/]*\)#\1#g")"$git
    PS1="$(hr)$PROMPTER_PREFIX$sshd$(tput rev)$_ps1$(tput sgr0)\n$PROMPTER_PREFIX$ " ; export PS1
    ;;
  $)
    PS1="$ " ; export PS1
    ;;
  esac
}
if [[ $- == *i* ]]; then
  # is an interactive shell
  export PROMPT_COMMAND=prompter
fi

# Set prompt display type
alias prompter_string_set_ps1_long="prompter long"
alias prompter_string_set_ps1_short="prompter short"
alias prompter_string_set_ps1_z="prompter z"
alias prompter_string_set_ps1_dollar="prompter $"
alias prompter_for_node="prompter node"
alias prompter_for_python="prompter python"
alias prompter_for_work="prompter work"
alias pfn="prompter node"
alias pfp="prompter python"

# Set PROMPTER_PREFIX with node version (via NVM)
function prompter_prefix_set_with_current_node_version() {
  prompter_prefix_unset
  current_node_version="$(nvm current 2>/dev/null)"
  if [[ "$current_node_version" == "system" ]]; then
    current_node_version="$(node -v)"
  fi
  PROMPTER_PREFIX="n$current_node_version: "
}

# Set PROMPTER_PREFIX with python version (via PYENV)
function prompter_prefix_set_with_current_python_version() {
  prompter_prefix_unset
  # get version value until space or newline
  current_python_version="$(pyenv version 2>/dev/null | cut -d' ' -f1)"
  PROMPTER_PREFIX="pv$current_python_version: "
}

# Unset PROMPTER_PREFIX
function prompter_prefix_unset() {
  PROMPTER_PREFIX=""
}

