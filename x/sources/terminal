# Erase the last command from history when chained, e.g.
# $ echo hiya; erase_command_from_history
function erase_command_from_history() {
  history -d $(history 1)
}

# Erase the last command from history
# $ echo hiya
# $ erase_the_last_command_from_history
function erase_the_last_command_from_history() {
  history -d $(history 1); history -d $(history 1)
}

# Copy the last command from history
# $ ssh -i ~/.ssh/some.pem user@server.com
# $ copy_the_last_command_from_history
# $ pbp
# ssh -i ~/.ssh/some.pem user@server.com
alias copy_the_last_command_from_history="erase; history 1 | sed 's#^ *[0-9]* *##' | pbcopy"

