#!/usr/bin/env bash

# Init
alias npm_init_yes="npm init -y"

# List Dependencies
alias npm_list_deps="npm list --depth 0 | less"
alias npm_list_deps_global="npm list --global --depth 0 | less"
alias npm_list_deps_outdated="npm outdated"
alias npm_list_deps_outdated_global="npm outdated --global"

# Check Dependencies (Always use pinning with --save-exact)
alias npm_check_deps_interactive="npm-check --update --save-exact"
alias npm_check_deps_global_interactive="npm-check --update --save-exact --global"

# Install Dependencies (Always use pinning with --save-exact)
alias npm_install_and_check_deps="npm install --save-exact && npm-check"
alias npm_install_and_check_deps_interactive="npm install --save-exact && npm-check --update --save-exact"
alias npmi="npm install --save-exact"
alias npmig="npm install --save-exact --global"
alias npmisd="npmi --save-exact --save-dev"

# Versioning
alias npm_version_patch="npm version patch"
alias npm_version_prerelease_bc-dev="npm version prerelease --preid=bc-dev"

# Package.json formatting
alias npm_prettier_package_json="npx prettier-package-json --write ./package.json"

# Run NPM Install on all subdirectories
function npm_install_for_all_subdirectories() {
  for d in $(find . -name 'package.json' | grep -v 'node_modules' | sed 's/\/package\.json//g'); do
    hr
    (
      cd "$d"
      echo "NPM Installing $d";
      npm install
    )
  done
}

# Check deps on subdirectories
function npm_check_deps_for_all_subdirectories() {
  for d in $(find . -name 'package.json' -maxdepth 2 | sed 's#/package.json##g'); do
    hr
    (
      cd "$d"
      echo "$d"
      npm-check -ps
    )
  done
}

# View NPM Stars for Username
function npm_stars_for_username() {
  # require username as argument
  if [ -z "$1" ]; then
    echo "Usage: npm_stars_for_username <username>"
    return 1
  fi
  npm stars "$@" | while IFS= read -r p; do
    npm view "$p" name description repository.url
    hr
  done
}
