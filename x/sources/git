function gt_pull_all_subdirectories() {
  for d in $(find . -name ".git" -maxdepth 2); do
  hr
  (
    cd "$d"/..
    echo "processing $d" | sed 's#\/\.git##';
    git pull
  )
  done
}

function degit_repo() {
  if [[ $# -ne 2 ]]; then
    cat <<EOF

  Get a git repo for a new project and remove its git history.

  Usage: degit_repo <repo> <dest>

EOF
  else
    git clone --depth 1 "$1" "$2" &&
    cd "$2" &&
    rm -rf .git
  fi
}

function degit_github_repo() {
  if [[ $# -ne 2 ]]; then
    cat <<EOF

  Get a git repo from GitHub for a new project and remove its git history.

  Usage: degit_github_repo <repo> <dest>

EOF
  else
    git clone --depth 1 "git@github.com:$1" "$2" &&
    cd "$2" &&
    rm -rf .git
  fi
}

function degit_bitbucket_repo() {
  if [[ $# -ne 2 ]]; then
    cat <<EOF

  Get a git repo from BitBucket for a new project and remove its git history.

  Usage: degit_bitbucket_repo <repo> <dest>

EOF
  else
    regit "git@bitbucket.org:$1" "$2"
  fi
}

function degit_dist_from_repo() {
  if [[ $# -ne 2 ]]; then
    cat <<EOF

  Get dist/**/* from a git repo

  Usage: degit_dist_from_repo <repo> <dest>

EOF
  else
    temp_dir="$(mktemp -d)"
    git clone --depth 1 "$1" "$temp_dir" &&
    cp -r "$temp_dir/dist/" "$2" &&
    rm -rf "$temp_dir"
  fi
}

function gt_stash_export() {
  (
    IFS=$'\n'
    stash_dir="${PWD}/stashes"
    mkdir -p "$stash_dir"
    cd "$stash_dir"
    stashes=( $(git stash list) )

    for stash in "${stashes[@]}"; do
      id=$( echo "$stash" | cut -d: -f1 )
      label=$( echo "$stash" | cut -d: -f3 )

      diffs=$(git --no-pager stash show --no-color -p "$id")
      diff_file="${stash_dir}/$stash.diff"
      [[ $diffs ]] && echo "$diffs" > "$diff_file" && echo "=> $diff_file"

      untracked=$(git --no-pager show --no-color "$id"^3 2>/dev/null)
      untracked_file="${stash_dir}/$stash.untracked"
      [[ $untracked ]] && echo "$untracked" > "$untracked_file" && echo "=> $untracked_file"
    done
  )
}
