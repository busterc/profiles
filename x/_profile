#!/usr/bin/env bash

# X _profile

function source_profile_x() {
  # cope with spaces in file/directory names
  local IFS_backup="$IFS"
  IFS=$'\n'

  local sources=($(dirname "${BASH_SOURCE[0]}")/sources/*)
  for s in "${sources[@]}"; do
    source "$s"
  done

  IFS="$IFS_backup"
}
source_profile_x

# Open .profiles in Editor
function profiles() {
  e "$HOME/.profiles"
}
