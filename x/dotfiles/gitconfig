[user]
  name = Buster Collings
  email = busterc@gmail.com
[github]
  user = busterc
[core]
  excludesfile = ~/.gitignore_global
  editor = vim
[url "git@github.com:"]
  insteadOf = gh:
[url "git@gist.github.com:"]
  insteadOf = gist:
[url "git@bitbucket.org:"]
  insteadOf = bb:
[url "git@bitbucket.org:busterc/"]
  insteadOf = bbbc:
[url "git@github.com:busterc/"]
  insteadOf = ghbc:

[push]
  default = simple
[pull]
	rebase = false

[diff]
	tool = icdiff
[difftool]
	prompt = false
[difftool "icdiff"]
	cmd = icdiff --highlight --line-numbers $LOCAL $REMOTE | less
[init]
	defaultBranch = main
